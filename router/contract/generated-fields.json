{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "v1",
  "description": "Path and context rules for fields whose values are generated by the router and may be normalized by differential fixtures.",
  "normalization_rule": "Normalize only when both path and context match a normalizable rule. Protected rules always win.",
  "normalizable": [
    {"path": "$.created_at", "contexts": ["server_generated_envelope"]},
    {"path": "$.updated_at", "contexts": ["server_state"]},
    {"path": "$.recorded_at", "contexts": ["conversation_record"]},
    {"path": "$.generated_at", "contexts": ["server_frame", "server_state"]},
    {"path": "$.expires_at", "contexts": ["server_lease", "server_control"]},
    {"path": "$.claimed_at", "contexts": ["delivery_state"]},
    {"path": "$.delivery_expires_at", "contexts": ["delivery_state", "server_frame"]},
    {"path": "$.lease_expires_at", "contexts": ["lease_state"]},
    {"path": "$.control_expires_at", "contexts": ["control_state"]},
    {"path": "$.received_at", "contexts": ["receipt_state"]},
    {"path": "$.timestamp", "contexts": ["jsonl_event"]},
    {"path": "$.frame_id", "contexts": ["server_frame"]},
    {"path": "$.correlation_id", "contexts": ["generated_http_fallback"]},
    {"path": "$.request_id", "contexts": ["generated_http_fallback"]},
    {"path": "$.lease_id", "contexts": ["server_lease"]},
    {"path": "$.message_incarnation_id", "contexts": ["server_message_incarnation"]},
    {"path": "$.incarnation_id", "contexts": ["server_reminder_incarnation"]},
    {"path": "$.uuid", "contexts": ["server_generated_uuid"]},
    {"path": "$.attachment_id", "contexts": ["server_attachment"]}
  ],
  "protected": [
    {"path": "$.created_at", "contexts": ["request", "echoed_response"]},
    {"path": "$.frame_id", "contexts": ["client_frame", "echoed_response"]},
    {"path": "$.request_id", "contexts": ["request", "echoed_response"]},
    {"path": "$.control_id", "contexts": ["client_frame", "forwarded_frame", "echoed_response"]}
  ]
}
