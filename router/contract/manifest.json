{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "v1",
  "status": "cors_verified",
  "source": {
    "http": "router-proxy/internal/transport/http.go",
    "websocket": "router-proxy/internal/transport/websocket.go",
    "protocol": "protocol/v1/schema.json",
    "database": ["router-proxy/internal/store/", "router-proxy/internal/store/migrations/"],
    "launcher": "tools/run_router.sh"
  },
  "cors": {
    "status": "verified",
    "recorded": true,
    "source_behavior": "The supported Go router gives Origin-bearing API requests wildcard CORS headers and returns 204 for Origin preflight.",
    "go_implementation": "implemented"
  },
  "http": [
    {"methods": ["OPTIONS"], "path": "/*", "source": "handleHttpRequest", "cors": "verified"},
    {"methods": ["GET"], "path": "/v1/health", "source": "handleHttpRequest"},
    {"methods": ["GET"], "path": "/v1/capabilities", "source": "handleHttpRequest"},
    {"methods": ["GET"], "path": "/v1/memory/policy", "source": "handleHttpRequest"},
    {"methods": ["POST"], "path": "/v1/memory/rebuild", "source": "handleMemoryRequest"},
    {"methods": ["POST"], "path": "/v1/memory/lookup", "source": "handleMemoryRequest"},
    {"methods": ["POST"], "path": "/v1/memory/expand", "source": "handleMemoryRequest"},
    {"methods": ["POST"], "path": "/v1/memory/apply", "source": "handleMemoryRequest"},
    {"methods": ["POST"], "path": "/v1/memory/touch", "source": "handleMemoryRequest"},
    {"methods": ["GET"], "path": "/v1/agents", "source": "handleHttpRequest", "cors": "verified"},
    {"methods": ["GET"], "path": "/v1/conversations", "source": "handleHttpRequest"},
    {"methods": ["GET"], "path": "/v1/attachments/{attachment_id}", "source": "serveImageAttachment"},
    {"methods": ["POST"], "path": "/v1/messages", "source": "enqueueHttpMessage"},
    {"methods": ["GET", "POST", "DELETE"], "path": "/v1/reminders", "source": "handleReminderCollection"},
    {"methods": ["GET", "PATCH", "DELETE"], "path": "/v1/reminders/{reminder_id}", "source": "handleReminderItem"},
    {"methods": ["GET", "POST"], "path": "/v1/prompt-templates", "source": "handlePromptTemplateCollection"},
    {"methods": ["GET", "PATCH", "DELETE"], "path": "/v1/prompt-templates/{template_id}", "source": "handlePromptTemplateItem"},
    {"methods": ["GET"], "path": "/v1/messages/{message_id}", "source": "handleHttpRequest"},
    {"methods": ["POST"], "path": "/v1/messages/{message_id}/retry", "source": "handleHttpRequest"},
    {"methods": ["DELETE"], "path": "/v1/messages/{message_id}", "source": "handleHttpRequest"},
    {"methods": ["GET", "POST"], "path": "/v1/tmux/windows", "source": "handleTmuxRequest"},
    {"methods": ["DELETE", "PATCH"], "path": "/v1/tmux/windows/{window}", "source": "handleTmuxRequest"},
    {"methods": ["POST"], "path": "/v1/tmux/windows/{window}/{action}", "actions": ["keys", "start", "stop", "restart", "resume", "rename"], "source": "handleTmuxRequest"},
    {"methods": ["GET", "POST"], "path": "/v1/managed-agents", "source": "handleManagedHTTP", "managed": true},
    {"methods": ["GET"], "path": "/v1/managed-directories", "source": "handleManagedHTTP", "managed": true},
    {"methods": ["GET"], "path": "/v1/history", "source": "handleManagedHTTP", "managed": true},
    {"methods": ["POST"], "path": "/v1/managed-agents/restart-all", "source": "handleManagedHTTP", "managed": true},
    {"methods": ["GET"], "path": "/v1/managed-agents/{id}", "source": "handleManagedHTTP", "managed": true},
    {"methods": ["GET"], "path": "/v1/managed-agents/{id}/children", "source": "handleManagedHTTP", "managed": true},
    {"methods": ["DELETE"], "path": "/v1/managed-agents/{id}", "source": "handleManagedHTTP", "managed": true},
    {"methods": ["POST"], "path": "/v1/managed-agents/{agent_id}/restart", "source": "handleManagedHTTP", "managed": true},
    {"methods": ["POST"], "path": "/v1/managed-agents/{id}/reset", "source": "handleManagedHTTP", "managed": true}
  ],
  "managed": {
    "enabled_by_default": false,
    "routes": ["/v1/managed-agents", "/v1/managed-directories", "/v1/history", "/v1/managed-agents/restart-all", "/v1/managed-agents/{id}", "/v1/managed-agents/{id}/children", "/v1/managed-agents/{agent_id}/restart", "/v1/managed-agents/{id}/reset"],
    "authority": "locally unauthenticated direct worker control",
    "idempotency": "worker-wide method and request ID with canonical path/body comparison",
    "legacy_agents_additive_when_authenticated": false
  },
  "ui_live": {
    "path": "/v1/ui-live",
    "protocol": "mecha.web/v1",
    "authority": "direct local reachability; no query credential or caller identity",
    "frames": ["managed_agents_snapshot", "managed_agent_delta", "managed_agent_removed", "managed_children_snapshot", "history_entry", "provider_auth_prompt", "provider_auth_state"],
    "frame_contracts": {
      "managed_children_snapshot": {
        "version_field": "lifecycle_version",
        "delivery": "authoritative full replacement",
        "recovery": "a stale or unreadable parent source publishes reconstructing with no children and never implies a terminal child state"
      }
    }
  },
  "websocket": {
    "path": "/v1/agents",
    "client_frames": [
      "register", "lease_renew", "activity", "model_catalog", "model_control", "model_control_result",
      "inline_tool_state", "inline_tool_control", "inline_tool_control_result",
      "goal_control", "goal_control_result", "reminder_lock_control", "reminder_lock_control_result",
      "goal_state", "message_arrival", "injection_requested", "ack", "nack", "ping",
      "subagent_sync_enable", "subagent_lifecycle_snapshot", "subagent_lifecycle_event", "subagent_state_resync"
    ],
    "server_frames": [
      "registered", "lease_rejected", "error", "pong", "message", "conversation_message", "reminders_changed",
      "model_control", "model_control_result", "inline_tool_state", "inline_tool_control", "inline_tool_control_result",
      "goal_control", "goal_control_result", "reminder_lock_control", "reminder_lock_control_result", "agent_goal_state", "delivery_acknowledged",
      "agent_activity", "agent_model_catalog", "message_arrival", "subagent_state_snapshot",
      "subagent_state_update", "subagent_state_replay", "subagent_lifecycle_acknowledged"
    ],
    "schema": "protocol/v1/schema.json"
  },
  "fixtures": {
    "http_outcomes": "http-outcomes.json",
    "frame_cases": "frame-cases.json",
    "generated_fields": "generated-fields.json",
    "transport_differential": "transport-differential.json"
  }
}
