{
  "name": "@mecha/router-ui-react",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run tests/component/mcp-servers-dialog.test.tsx",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:transport": "vitest run tests/transport",
    "test:acceptance": "vitest run tests/acceptance",
    "test:acceptance:bcb": "node tests/acceptance/bcb-runner.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "dagre": "^0.8.5",
    "markdown-it": "14.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.2",
    "fake-indexeddb": "6.2.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
