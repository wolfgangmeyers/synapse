        "values": {"name": "Ada"},
        "selection": {"draft": "prefix suffix", "start": 7, "end": 13, "replacement": "TEMPLATE"},
        "import": {"format": "mecha-prompt-templates", "version": 1, "templates": [{"name": "Daily", "body": "Review ${date}", "id": "template-1", "updated_at": "2026-01-01T00:00:00.000Z"}]}
      },
      "expected": {
        "tokens": ["name", "missing"],
        "rendered": "Hello Ada; Ada at ${missing} ${bad",
        "selection": {"text": "prefix TEMPLATE", "caret": 15},
        "imported": [{"name": "Daily", "body": "Review ${date}", "id": "template-1", "updated_at": "2026-01-01T00:00:00.000Z"}],
        "export": {"format": "mecha-prompt-templates", "version": 1, "templates": [{"name": "Daily", "body": "Review ${date}", "id": "template-1", "updated_at": "2026-01-01T00:00:00.000Z"}]}
